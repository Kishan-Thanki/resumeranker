# Database — used by both the api and the postgres container.
# Change POSTGRES_PASSWORD to a long random value for any non-local deploy
# (e.g. `openssl rand -hex 32`). DATABASE_URL must reference the same one.
POSTGRES_USER=resumeranker
POSTGRES_PASSWORD=resumeranker
POSTGRES_DB=resumeranker
DATABASE_URL=postgresql+asyncpg://resumeranker:resumeranker@postgres:5432/resumeranker

# Redis (queue + cache, single DB for v1)
REDIS_URL=redis://redis:6379/0

# LLM — leave as "replace-me" to run in stub mode (no API costs).
# Provider is determined by LLM_MODEL. Examples:
#   gemini/gemini-2.5-flash      → Google AI Studio (free tier available)
#   anthropic/claude-haiku-4-5   → Anthropic (paid)
#   openai/gpt-4o-mini           → OpenAI (paid)
# The LLM_API_KEY is passed explicitly to litellm — its value should match
# whichever provider LLM_MODEL points at.
LLM_API_KEY=replace-me
LLM_MODEL=gemini/gemini-2.5-flash

# Email — leave as "replace-me" to print magic-link URLs to stdout instead
# of sending real email. Wire when you have a verified Resend domain.
RESEND_API_KEY=replace-me
RESEND_FROM_EMAIL=login@yourdomain.com
# Where /contact form submissions land. Never exposed to visitors; the
# form just shows a "thanks, we'll be in touch" success message.
CONTACT_TO_EMAIL=contact@yourdomain.com

# App. Set APP_BASE_URL to your public origin once deployed (used in
# magic-link emails).
APP_BASE_URL=http://localhost:5173
ENVIRONMENT=development

# Limits
MAX_RESUMES_PER_USER_PER_DAY=10
MAX_FILE_SIZE_MB=10
# Service-wide daily cap (sum across all users). Tuned to stay under the
# LLM provider's free tier; raise once you have observed usage data.
MAX_ANALYSES_PER_DAY_GLOBAL=25

# Encryption-at-rest key for resume_text and jd_text columns. Generated
# with Fernet (urlsafe base64-encoded 32 random bytes). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave as "replace-me" to run unencrypted in local dev; production MUST
# set a real value. Rotating this value invalidates every existing row —
# write a dedicated migration with MultiFernet if you need to rotate.
RESUME_ENCRYPTION_KEY=replace-me
