[Unit]
Description=ResumeRanker Streamlit dashboard
After=network.target resumeranker-analysis.service
Wants=resumeranker-analysis.service

[Service]
Type=simple
# Create with: useradd --system --no-create-home --shell /usr/sbin/nologin resumeranker
User=resumeranker
Group=resumeranker

# Adjust to wherever this repo is checked out on the server.
WorkingDirectory=/opt/resumeranker/analysis_dashboard
EnvironmentFile=/opt/resumeranker/analysis_dashboard/.env
ExecStart=/opt/resumeranker/analysis_dashboard/.venv/bin/streamlit run \
    src/analysis_dashboard/app.py \
    --server.address=127.0.0.1 \
    --server.port=8501 \
    --server.maxUploadSize=10 \
    --browser.gatherUsageStats=false

Restart=on-failure
RestartSec=2

# --- Resource limits tuned for a small 1 GB / 1/8 OCPU VM ---
MemoryMax=512M
MemoryHigh=384M
CPUQuota=80%
TasksMax=256

# --- Hardening (replaces Docker non-root/no-new-privileges) ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/opt/resumeranker/analysis_dashboard

[Install]
WantedBy=multi-user.target
