[Unit]
Description=ResumeRanker Caddy reverse proxy
After=network.target resumeranker-analysis-dashboard.service
Wants=resumeranker-analysis-dashboard.service

[Service]
Type=simple
# Create with: useradd --system --no-create-home --shell /usr/sbin/nologin caddy
User=caddy
Group=caddy

# Adjust to wherever this repo is checked out on the server.
WorkingDirectory=/opt/resumeranker
Environment=DASHBOARD_DOMAIN=app.example.com
Environment=DASHBOARD_UPSTREAM=127.0.0.1:8501

ExecStart=/usr/bin/caddy run --config /opt/resumeranker/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config /opt/resumeranker/Caddyfile --adapter caddyfile

Restart=on-failure
RestartSec=2

# --- Resource limits tuned for a small 1 GB / 1/8 OCPU VM ---
MemoryMax=256M
MemoryHigh=192M
CPUQuota=60%
TasksMax=256

# --- Hardening (replaces Docker non-root/no-new-privileges) ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/opt/resumeranker

[Install]
WantedBy=multi-user.target
