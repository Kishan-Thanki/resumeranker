# -----------------------------------------------------------------------------
# Analysis Service
# -----------------------------------------------------------------------------

ANALYSIS_GRPC_HOST=localhost
ANALYSIS_GRPC_PORT=50051

# Full gRPC endpoint used by the Streamlit UI.
ANALYSIS_GRPC_ADDRESS=localhost:50051


# -----------------------------------------------------------------------------
# Streamlit
# -----------------------------------------------------------------------------

STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# -----------------------------------------------------------------------------
# Beta abuse control (app-only, no auth required)
# -----------------------------------------------------------------------------
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=600
DAILY_REQUEST_LIMIT=10
DAILY_WINDOW_SECONDS=86400

# Optional challenge gate for suspicious traffic only.
HUMAN_CHECK_ENABLED=false
HUMAN_CHECK_THRESHOLD=3
