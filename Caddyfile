# Replace the default domain with the real dashboard hostname.
{$DASHBOARD_DOMAIN:dashboard.example.com} {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Use analysis-dashboard:8501 when Caddy runs in the Compose network.
    # Use 127.0.0.1:8501 when Caddy runs on the host machine.
    reverse_proxy {$DASHBOARD_UPSTREAM:127.0.0.1:8501}
}
